# 이 저장소는 학부 과정·인턴·대회·개인 프로젝트를 모은 아카이브다.
# "설치하거나 빌드하면 다시 생기는 것"은 올리지 않는다 -- 용량만 키우고
# 기기마다 어차피 새로 만들어야 하기 때문이다.
#
# 2026-08-28 정리: 실제로 걷어낸 것들을 규칙으로 굳혔다.
#   venv 계열 약 1.5GB · wheelhouse(pip 캐시) 3.0GB · 모델 가중치 다수

# ── 파이썬 가상환경 ─────────────────────────────────
venv/
.venv/
venv_win/
venv_bundle/
yolov8_cls_env/
.jetson-python/
.build_venv_tmp*/

# ── 파이썬 캐시 ────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mpl-cache/

# ── 패키지 캐시 (pip / npm) ────────────────────────
wheelhouse/
node_modules/

# ── ROS 2 워크스페이스 빌드 산출물 ─────────────────
# colcon build 하면 다시 생긴다
build/
install/
log/

# ── 다운로드받는 모델 가중치 ───────────────────────
# 각 프로젝트의 다운로드 스크립트나 학습으로 다시 만든다
*.pt
*.onnx
*.engine
*.task
*.tflite
*.joblib
bundle_models/
models/weights/
models/engines/

# ── 빌드 산출물 ────────────────────────────────────
# obj/ 는 비주얼스튜디오(.NET) 중간 산출물이다.
# bin/ 은 일부러 넣지 않았다 -- Express 앱의 bin/www 처럼
# bin/ 아래가 진입점 소스인 경우가 있다.
# *.spec(PyInstaller 빌드 설정)도 넣지 않았다 -- 빌드 방법을
# 기록한 파일이라 남겨두는 편이 낫다.
obj/
dist/

# ── 실행 중 생기는 것 ──────────────────────────────
*.log
logs/*.log
runs/

# ── 에디터 · OS ────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── AI 어시스턴트 설정 ─────────────────────────────
.agents/
.claude/
.codex/

# ── 기타 ───────────────────────────────────────────
*.csv
*.zip
*.dll

# ★ *.sh 는 일부러 빼 놓았다.
#    예전 규칙에는 *.sh 가 들어 있었는데, 로보틱스 프로젝트의
#    TurtleBot3_전체실행.sh · sound_anomaly_led.sh · 시연용.sh 처럼
#    실행 스크립트 자체가 소스 코드다. 새로 만든 스크립트가 조용히
#    누락되지 않도록 무시 목록에서 뺐다.
